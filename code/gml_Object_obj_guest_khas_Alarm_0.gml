global.msg[0] = "Ah! Whom do we have here?/";
global.msg[1] = "Greetings, and do forgive, it appears I have lost myself within the thoughts of mine, heh./";
global.msg[2] = "A little birdie told me it be thine day of birth./";
global.msg[3] = "Happy day, birthRobin! Truly, I have much to thank thee for./";
global.msg[4] = "You hath been the guide that led me toward a better life, people I shan’t ever forget./";
global.msg[5] = "To the happiest I’ve ever been./";
global.msg[6] = "There’s naught I can say or do to truly express the gratitude swelling within my person./";
global.msg[7] = "And remember, we shall all remain by your side. For you, yourself, and the person you are./";
global.msg[8] = "Take care yourself, we shall await thee always./";
global.msg[9] = "May the winds be ever in thine favour, may any challenge in thine path be met, and may fortune smile upon thee./";
global.msg[10] = "Indeed, once more, I wish thee a truly happy birthday!/";
global.msg[11] = "Now, I believe there be others whom may wish to see you as well, don’t let myself keep you here too long./";
global.msg[12] = "* Khas/%%";

