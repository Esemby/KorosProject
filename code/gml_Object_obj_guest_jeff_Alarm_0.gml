global.msg[0] = scr_gettext("jeff_001");  // ROBIN! GOOD BIRBING!/
global.msg[1] = scr_gettext("jeff_002");  // IT’S YOUR BIRBDAY!/
global.msg[2] = scr_gettext("jeff_003");  // I mean, your birthday! Your birbday birthday!/
global.msg[3] = scr_gettext("jeff_004");  // Hooray!/
global.msg[4] = scr_gettext("jeff_005");  // I hope you have a wonderful, amazing, and spectacular day!/
global.msg[5] = scr_gettext("jeff_006");  // In fact, you should have lots of wonderful days! I mean, people do birthday weeks now, right?/
global.msg[6] = scr_gettext("jeff_007");  // I’m glad to hear you’re doing better, and I hope your recovery goes well./
global.msg[7] = scr_gettext("jeff_008");  // I’m sorry to hear that you’ve had a hard year, but you’re a lot stronger than you realize./
global.msg[8] = scr_gettext("jeff_009");  // Not just for enduring these difficult times, but for being brave enough to ask for help./
global.msg[9] = scr_gettext("jeff_010");  // Sending you lots of love, Robin!/
global.msg[10] = scr_gettext("jeff_011");  // I, uh, would have gotten you a gift, but I gambled away all my Noxy coins./
global.msg[11] = scr_gettext("jeff_012");  // I could probably win them back if I had more luck./
global.msg[12] = scr_gettext("jeff_013");  // I’ve heard that, if you rub a bald head, you’ll be blessed with good fortune./
global.msg[13] = scr_gettext("jeff_014"); // Wait, please don’t leave! I was just kidding!/%%




