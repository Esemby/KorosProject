myinteract = 3;
global.msc = 0;
global.typer = 5;
global.facechoice = 0;
global.faceemotion = 0;

global.msg[0] = "* BOIO/";
global.msg[1] = "* Mah boio/";
global.msg[2] = "* I guess you've spoken to#        everyone by now huh?/";
global.msg[3] = "* Did you enjoy being turned#    into a tiny pixel version of#    yourself.../";
global.msg[4] = "* In a world where you can#        become GOD??/";
global.msg[5] = "* Sick!!!^2 Sick boio!!!!/";
global.msg[6] = "* Anyway.../";
global.msg[7] = "* I've always wanted to use#     my powers to turn you into a#    pixel version of yourself.../";
global.msg[8] = "* And put you into a game where#   you can become a god./";
global.msg[9] = "* I guess that makes me a.../";
global.msg[10] = "* SICK!!!^2 SICK BOIO!!!!/";
global.msg[11] = "* However^2 turns out cosmic star#   powers also need educational#    foundations./";
global.msg[12] = "* And that's too much work./";
global.msg[13] = "* So I forced-^3#  Asked for help./";
global.msg[14] = "* And I got it./";
global.msg[15] = "* Esemby,^1 Ominous,^1 Raccoon,^1      Frost,^1 Nito,^1 Chara,^1      Cannedtaters.../";
global.msg[16] = "* All of your birbs./";
global.msg[17] = "* They all came together to#       help make this possible./";
global.msg[18] = "* I'm just the unparalleled#       genius with the idea./";
global.msg[19] = "* They are the silly people with#  the silly,^1 not-all-important-#   whatsoever knowledge.../";
global.msg[20] = "* Of how to do absolutely#         everything.^2 Heh./";
global.msg[21] = "* Nerds./";
global.msg[22] = "* All this for you.^2 Just to say../";
global.msg[23] = "* Did you know you are truly#      one of a kind?/";
global.msg[24] = "* Did you know that when you#      introduced me to this world.../";
global.msg[25] = "* I knew then that my tiny#        little boio.../";
global.msg[26] = "* So little,^1 so tiny,^1#             so annoying.../";
global.msg[27] = "* Had turned into a person of#     such magnitude of.../";
global.msg[28] = "* Inspiration,^1 love,^1 and an#       inner world I desperately#       wanted to be a part of./";
global.msg[29] = "* I saw your intelligence#         and your strength./";
global.msg[30] = "* I saw your creativity#           and courage./";
global.msg[31] = "* And.../";
global.msg[32] = "* SICK!!!^2 SICK DESIRE !!!! TO#     WATCH ME CRY WHEN I KILLED#      TOR-^3/";
global.msg[33] = "* Anyway./";
global.msg[34] = "* You did tell me to#             “READ BETTER THEN IDIOT”/";
global.msg[35] = "* And I did.^3#Eventually./";
global.msg[36] = "* I want you to know you're#       loved./";
global.msg[37] = "* You're someone that has played#  every route of this game,^1#       spoken to all the people./";
global.msg[38] = "* You look for secrets and#        hidden clues,^1 you explore#       everything the game gives you./";
global.msg[39] = "* Sometimes life is like#a game./";
global.msg[40] = "* And though yeah we may not#      come back to life if we die.../";
global.msg[41] = "* We do however have the#          option to explore everything./";
global.msg[42] = "* So if currently the route#       you're on is boring and bad#     and sad and ugh.../";
global.msg[43] = "* Maybe it's time to try#a new     route./";
global.msg[44] = "* Even if that one turns out#      to be boring too./";
global.msg[45] = "* I guess I just want to ask.../";
global.msg[46] = "* Can I also come with?/";
global.msg[47] = "* Can I enjoy the journey of#      life with you?/";
global.msg[48] = "* I hope I get to see every#       version of you./";
global.msg[49] = "* The cool boio.^2#                  The sick!!!^1 Sick boio!!!!/";
global.msg[50] = "* The kind boio.^2#                  The mean boio./";
global.msg[51] = "* The happy boio.^2#                 The sad boio./";
global.msg[52] = "* The lazy boio.^2#                  The adventurous boio./";
global.msg[53] = "* Just the boio./";
global.msg[54] = "* Because any version of you.../";
global.msg[55] = "* Every version of you.../";
global.msg[56] = "* Are precious./";
global.msg[57] = "* To me.^2#                          To your birbs.^2#                  To the universe./";
global.msg[58] = "* And I hope...^2#                   To you too./";
global.msg[59] = "* As Mewtwo once said and I        always#quoted crying,^1            grabbing your#shoulders.../";
global.msg[60] = "* I see now that the              circumstances of one's birth are irrelevant.../";
global.msg[61] = "* It is what you do with the#      gift of life that determines#    who you are.”/";
global.msg[62] = "* We both know our circumstance#   of our birth./";
global.msg[63] = "* But I must say.../";
global.msg[64] = "* It wasn't until I got to#        truly know you,^1 as the boio.../";
global.msg[65] = "* That I understood that you#      being who you are.../";
global.msg[66] = "* Becoming who you are...^2#         Has been a gift./";
global.msg[67] = "* One I will cherish for my#       whole life./";
global.msg[68] = "* You,^1 by virtue of choosing to    be#the person you are today.../";
global.msg[69] = "* Has given me,^1 us,^1 your#          community the gift of YOU./";
global.msg[70] = "* Of Robin./";
global.msg[71] = "* And what a beautiful#            unparalleled gift that is./";
global.msg[72] = "* Thank you./";
global.msg[73] = "* Happy birbday my boio./";
global.msg[74] = "* And don’t forget/";
global.msg[75] = "* I’m with you in the dark/%%";

mydialoguer = instance_create(0, 0, obj_dialoguer);
talkedto += 1;
global.talked_to_koro = 1;