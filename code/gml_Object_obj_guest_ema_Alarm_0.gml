global.msg[0] = "Happy Burdthday Jason Todd!!!Waithold on... *reads a paper* Ouh   my bad…/";
global.msg[1] = "HAPPY BURDTHAY… *looks at the    paper again* ROBIN!!!/";
global.msg[2] = "It's another year huh? /";
global.msg[3] = "How do you feel now that u are   eons old? How is ur back?/";
global.msg[4] = "I'm not gonna lie, more than a   burd u look like a shrimp./";
global.msg[5] = "Well both of them are foods so   it's ok./";
global.msg[6] = "Another year pass, more things   happened/";
global.msg[7] = "Still u are the same crazy small little chicken/";
global.msg[8] = "The one we all know, care and    love./";
global.msg[9] = "Except the ones that want to eat u/";
global.msg[10] = "just saying, hunger can make the most sane person to want to grillu/";
global.msg[11] = "or make a butter chicken out of u/";
global.msg[12] = "Should I be kind just because is ur birthday?/";
global.msg[13] = "mmmm… I don't think so.../";
global.msg[14] = "or maybe I could make an...      exception/";
global.msg[15] = "it's once in the year anyway./";
global.msg[16] = "This may be not the best year    until now/";
global.msg[17] = "maybe it is, who knows/";
global.msg[18] = "maybe it gonna be better the restmaybe not/";
global.msg[19] = "we can't be sure about that/";
global.msg[20] = "just time will tell/";
global.msg[21] = "still we know one thing…/";
global.msg[22] = "we all care for you/";
global.msg[23] = "the ones near u/";
global.msg[24] = "the ones that are away but       present/";
global.msg[25] = "the ones that don't talk that    much/";
global.msg[26] = "and the ones that are caring and protecting u from afar/";
global.msg[27] = "we all have a collective wish foru/";
global.msg[28] = "and is the best of the best/";
global.msg[29] = "just for the right person, you.  (editor is this checked?)/";
global.msg[30] = "U deserve it?/";
global.msg[31] = "No.../";
global.msg[32] = "I mean yes.../";
global.msg[33] = "So make sure to live ur life to  the fullest/";
global.msg[34] = "we'll be looking for u to achieveeverything u want and more/";
global.msg[35] = "u got this little butter chicken!/";
global.msg[36] = "Hope u have a wonderful birthday/";
global.msg[37] = "a wonderful life/";
global.msg[38] = "and less bullets to shoot at us!/";
global.msg[39] = "Before u go, here, a little      present, believe me, u need it.  *gives a soap*/";
